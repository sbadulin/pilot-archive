# Set S3_PUBLIC_HOST to the PUBLIC bucket hostname from Selectel, without https://.
# Main domain is served here because Selectel S3/CDN does not accept an apex domain.
pilot-archive.ru {
    encode zstd gzip
    header Access-Control-Allow-Origin https://pilot-archive.pages.dev
    # Журнал запросов для подсчёта посетителей (scripts/visitor-report.sh). IP-адреса —
    # персональные данные, поэтому журнал хранится не дольше 30 дней и не уходит с сервера.
    log {
        output file /var/log/caddy/pilot-archive.log {
            # Daily rotation and expiry are handled by deploy/pilot-archive.logrotate.
            # Size-only rotation can leave old requests in a small active log forever.
            roll_disabled
        }
        format json
    }
    @authorStats {
        path /_stats/author /_stats/adult
        method GET
    }
    header @authorStats Cache-Control "no-store"
    respond @authorStats "" 204
    @root path /
    rewrite @root /index.html
    reverse_proxy https://{$S3_PUBLIC_HOST} {
        header_up Host {$S3_PUBLIC_HOST}
    }
}
