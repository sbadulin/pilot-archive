{
  "name": "pervyi-pilot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "preview": "python3 -m http.server 4173 --bind 127.0.0.1 --directory dist",
    "db:migrate": "wrangler d1 migrations apply pilot_archive --remote",
    "deploy": "npm run build:admin && npm run deploy:pages",
    "deploy:pages": "wrangler pages deploy dist-admin --project-name pilot-archive --commit-dirty=true",
    "dev": "vite",
    "build:admin": "node build.mjs --admin",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "verify:archive": "node scripts/verify-archive.mjs",
    "catalog:generate": "node scripts/generate-base-catalog.mjs",
    "manifest:rebuild": "node --experimental-strip-types scripts/rebuild-manifest.mjs",
    "archive:migrate": "node --experimental-strip-types scripts/migrate-published-to-archive.mjs",
    "build:all": "npm run build && npm run build:admin",
    "check": "npm run typecheck && npm test && npm run verify:archive && npm run build:all && node scripts/verify-build.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.0.4",
    "lucide-react": "0.503.0",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "esbuild": "0.21.5",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "pdfjs-dist": "5.4.624",
    "typescript": "5.6.3",
    "@vitejs/plugin-react": "4.3.4",
    "vite": "6.1.0",
    "wrangler": "4.129.1",
    "@playwright/test": "1.55.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
